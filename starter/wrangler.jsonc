{
  // Your product's settings. /ship fills in the parts marked FILL.
  "name": "ai-proof",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-proof-db", "database_id": "FILL" }
  ],
  "vars": { "OWNER_NAME": "FILL" },
  "observability": { "enabled": true }
}
