{
  "permissions": {
    "allow": [
      "Bash(npx wrangler:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(curl -fsSL https://raw.githubusercontent.com/aiproofsaas/ai-proof-harness/main/:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\""
          }
        ]
      }
    ]
  }
}
